# Copia questo file in .env e valorizza con le tue chiavi reali.
# .env non va mai committato (è già in .gitignore).

# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# Solo per script locali one-shot (scripts/seed-modelli.mjs), MAI usata dal client:
# Supabase — Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Password condivisa di accesso al sito (vedi src/components/LoginGate.jsx). Su Vercel: Settings > Environment Variables.
VITE_ACCESS_PASSWORD=placeholder-password

# Password della modalità presentazione (aprendo il sito con ?demo=1), da dare a persone esterne all'azienda.
VITE_DEMO_PASSWORD=placeholder-password-demo
# Solo per un deploy dedicato alla demo: modalità presentazione sempre attiva (e senza VITE_ACCESS_PASSWORD).
# VITE_SOLO_DEMO=true
